<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DumpSearch.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DumpSearch.App.ViewModels"
    Title="Dump Search · 全盘重复文件查找">

    <Grid x:Name="RootGrid" Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏留白：内容延伸到标题栏后必须留出可拖拽区域 -->
        <Grid Grid.Row="0" Background="Transparent">
            <TextBlock Text="Dump Search" FontSize="12" Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= 左侧：扫描范围 ================= -->
            <Border Grid.Column="0" x:Name="ScopePanel" Width="352"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{StaticResource PanelStrokeBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="16,16,16,16" Spacing="12">

                        <!-- 盘符 -->
                        <StackPanel Spacing="4">
                            <Grid>
                                <TextBlock Text="扫描范围" Style="{StaticResource SectionTitleStyle}"
                                           Margin="0" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="全选" Click="OnSelectAllDrives"
                                            Style="{StaticResource TextLinkButtonStyle}" />
                                    <Button Content="全不选" Click="OnSelectNoDrives"
                                            Style="{StaticResource TextLinkButtonStyle}" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl x:Name="DriveList"
                                          ItemsSource="{x:Bind ViewModel.Drives, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DriveItem">
                                        <Border Padding="8,4" CornerRadius="4"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" Margin="0,1">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                          VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{x:Bind Title}" FontSize="13"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Subtitle}"
                                                               FontSize="11" Opacity="0.6" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{x:Bind FreeText}"
                                                           FontSize="11" Opacity="0.6"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- 附加目录：用可勾选的列表，而不是一个多行文本框。
                             多行文本框没法逐项勾选（想去掉一个目录只能手改文本），
                             而且长路径恰恰是最需要用选择器指定、又最容易手打错的。 -->
                        <!-- CASE:folderlist -->
                        <StackPanel Spacing="4">
                            <Grid>
                                <TextBlock Text="只扫指定文件夹" Style="{StaticResource FieldLabelStyle}"
                                           VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="添加…" Click="OnBrowseDir"
                                            Style="{StaticResource TextLinkButtonStyle}" />
                                    <Button x:Name="ClearFoldersButton" Content="清空"
                                            Click="OnClearFolders"
                                            Style="{StaticResource TextLinkButtonStyle}" />
                                </StackPanel>
                            </Grid>

                            <Border x:Name="FolderListCard" Style="{StaticResource CardStyle}" Padding="0,4">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Folders, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ScopeFolder">
                                            <Grid ColumnSpacing="6" Padding="8,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                          VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind TitleText}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind SubtitleText}" FontSize="10"
                                                               Style="{StaticResource MonoPathStyle}"
                                                               ToolTipService.ToolTip="{x:Bind Path}" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="移除"
                                                        Click="OnRemoveFolder"
                                                        Style="{StaticResource TextLinkButtonStyle}"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <TextBlock x:Name="FolderHintText"
                                       Style="{StaticResource CaptionStyle}" FontSize="11"
                                       Text="取消勾选即可只扫其余文件夹" />
                            <Button Content="浏览添加文件夹…" Click="OnBrowseDir"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" />
                        </StackPanel>
                        <!-- /CASE:folderlist -->

                        <!-- 筛选条件 -->
                        <Border Style="{StaticResource CardStyle}" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="筛选条件" Style="{StaticResource SectionTitleStyle}"
                                           Margin="0" />
                                <StackPanel Spacing="3">
                                    <TextBlock Text="文件大小（1 / 10M / 1G）" Style="{StaticResource FieldLabelStyle}" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="MinSizeBox" Grid.Column="0" Text="1"
                                                 Style="{StaticResource FieldStyle}" />
                                        <TextBlock Grid.Column="1" Text="至" VerticalAlignment="Center"
                                                   Opacity="0.6" FontSize="12" />
                                        <TextBox x:Name="MaxSizeBox" Grid.Column="2"
                                                 Style="{StaticResource FieldStyle}"
                                                 PlaceholderText="不限" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="只查扩展名" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="IncludeExtBox" PlaceholderText="留空 = 全部"
                                             Style="{StaticResource FieldStyle}" />
                                </StackPanel>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="排除扩展名" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="ExcludeExtBox" Text=".tmp,.log,.bak"
                                             Style="{StaticResource FieldStyle}" />
                                </StackPanel>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="排除目录名" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="ExcludeDirsBox"
                                             Text="Windows, Program Files, ProgramData, node_modules, $Recycle.Bin"
                                             Style="{StaticResource FieldStyle}" />
                                </StackPanel>
                                <CheckBox x:Name="VerifyCheck" Style="{StaticResource CheckRowStyle}"
                                          Content="逐字节校验" IsChecked="True" />
                                <CheckBox x:Name="HardLinkCheck" Style="{StaticResource CheckRowStyle}"
                                          Content="折叠硬链接" IsChecked="True" />
                                <CheckBox x:Name="CloudCheck" Style="{StaticResource CheckRowStyle}"
                                          Content="跳过云端占位符" IsChecked="True" />
                                <CheckBox x:Name="EmptyCheck" Style="{StaticResource CheckRowStyle}"
                                          Content="包含 0 字节文件（危险）" IsChecked="False" />
                            </StackPanel>
                        </Border>

                        <!-- 保留策略 -->
                        <Border Style="{StaticResource CardStyle}" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="每组保留哪一个" Style="{StaticResource SectionTitleStyle}"
                                           Margin="0" />
                                <ComboBox x:Name="KeepRuleBox" HorizontalAlignment="Stretch"
                                          MinHeight="30" SelectionChanged="OnKeepRuleChanged" />
                                <TextBlock x:Name="KeepRuleHint" Style="{StaticResource CaptionStyle}"
                                           FontSize="11" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- 主操作固定在底部：配置项再多，"开始扫描"也永远点得到 -->
                    <Border Grid.Row="1" Padding="16,8,16,16"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{StaticResource PanelStrokeBrush}">
                        <StackPanel Spacing="8">
                            <Button x:Name="StartButton" Content="开始扫描"
                                    Style="{StaticResource ToolBarButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    MinHeight="38" Click="OnStartScan" />
                            <Button x:Name="CancelButton" Content="停止"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    MinHeight="32" Visibility="Collapsed"
                                    Click="OnCancelScan" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 可拖动分隔条。不要在 XAML 里写 Cursor：InputSystemCursor
                 无法从字符串游标名转换，XamlCompiler 会直接失败。 -->
            <Thumb x:Name="ScopeSplitter" Grid.Column="0" Width="6"
                   HorizontalAlignment="Right" Opacity="0"
                   DragCompleted="OnSplitterDragCompleted">
                <Thumb.Resources>
                    <SolidColorBrush x:Key="ThumbBackground" Color="Transparent" />
                </Thumb.Resources>
            </Thumb>

            <!-- ================= 右侧：结果 ================= -->
            <Grid Grid.Column="1" Margin="16,8,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="重复文件" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock x:Name="SummaryText" Style="{StaticResource CaptionStyle}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" Spacing="8">
                        <!-- CASE:keepbar -->
                        <Button x:Name="KeepThisOneButton" Content="保留此项" MinHeight="32"
                                ToolTipService.ToolTip="把选中的这个文件设为该组的保留项（也可直接双击该行）"
                                Click="OnKeepThisOne" IsEnabled="False" />
                        <Button x:Name="ResetKeeperButton" Content="按规则" MinHeight="32"
                                ToolTipService.ToolTip="取消本组的手动指定，回到上方保留策略"
                                Click="OnResetKeeper" IsEnabled="False" />
                        <Button Content="全部按规则" MinHeight="32"
                                ToolTipService.ToolTip="清除所有手动指定的保留项"
                                Click="OnResetAllKeepers" />
                        <!-- /CASE:keepbar -->
                        <Button x:Name="ExportCsvButton" Content="导出 CSV" Click="OnExportCsv"
                                Visibility="Collapsed" />
                        <Button x:Name="ExportScriptButton" Content="生成脚本" Click="OnExportScript"
                                Visibility="Collapsed" />
                        <Button x:Name="CleanButton" Content="预览并清理…"
                                Style="{StaticResource ToolBarButtonStyle}"
                                Click="OnPreviewClean" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                    <AutoSuggestBox Width="230" PlaceholderText="筛选 name:/path:/ext:"
                                    QueryIcon="Find" TextChanged="OnFilterChanged" />
                    <ComboBox x:Name="SortBox" Width="150" MinHeight="32"
                              SelectionChanged="OnSortChanged" />
                    <ToggleButton x:Name="SortDirToggle" Content="降序" MinHeight="32"
                                  MinWidth="72" Click="OnSortDirectionToggle" />
                    <Button Content="全选" MinHeight="32" Click="OnCheckAll" />
                    <Button Content="全不选" MinHeight="32" Click="OnCheckNone" />
                    <Button Content="反选" MinHeight="32" Click="OnInvert" />
                    <Button Content="展开" MinHeight="32" Click="OnExpandAll" />
                    <Button Content="折叠" MinHeight="32" Click="OnCollapseAll" />
                </StackPanel>

                <!-- 表头 + 结果列表。表头和数据行共用 Tokens 里的 ColXxx 宽度资源，
                     改列宽只改一处，不会出现表头与数据错位。 -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- CASE:colheader -->
                    <Grid Grid.Row="0" Padding="8,0,8,6" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="124" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="#" Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="1" Text="文件 / 所在位置"
                                   Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="2" Text="大小"
                                   Style="{StaticResource ColumnHeaderStyle}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="份数"
                                   Style="{StaticResource ColumnHeaderStyle}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="可释放"
                                   Style="{StaticResource ColumnHeaderStyle}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="修改时间"
                                   Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="6" Text="处理"
                                   Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="7" Text="所在卷"
                                   Style="{StaticResource ColumnHeaderStyle}" />
                    </Grid>
                    <!-- /CASE:colheader -->

                    <ListView x:Name="ResultsList" Grid.Row="1"
                              Style="{StaticResource ResultsListViewStyle}"
                              ItemContainerStyle="{StaticResource ResultsItemContainerStyle}"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              ItemClick="OnResultItemClick"
                              DoubleTapped="OnResultDoubleTapped"
                              ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ResultRow">
                                <!--
                                  悬停详情。全部用扫描时已在手的数据，不做任何 IO：
                                  悬停时读磁盘会卡 UI，而创建/访问时间都要额外开句柄，
                                  在遍历阶段为每个文件多开一次会把扫描拖慢一个数量级。
                                -->
                                <Grid Padding="0,3" ColumnSpacing="10">
                                    <!--
                                      悬停详情。全部用扫描时已在手的数据，不做任何 IO：
                                      悬停时读磁盘会卡 UI，而创建/访问时间都要额外开句柄，
                                      在遍历阶段为每个文件多开一次会把扫描拖慢一个数量级。
                                      放在 DataTemplate 里而不是由视图模型造控件——
                                      列表是虚拟化的，只有可见行才会生成这份内容。

                                      注意 ColumnDefinitions 必须排在 ToolTipService.ToolTip
                                      之前：XAML 里一旦开始属性元素的嵌套内容，就不能再回头
                                      写另一个属性元素（ToolTip 带内容时它算内容），
                                      顺序反了 XamlCompiler 直接失败且只报「错误: 1」。
                                    -->
                                    <!-- CASE:rowcols -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="250" />
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="124" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- /CASE:rowcols -->
                                    <!-- CASE:tooltip -->
                                    <ToolTipService.ToolTip>
                                        <Border Style="{StaticResource DetailCardStyle}">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{x:Bind DetailPathText}"
                                                           Style="{StaticResource DetailValueStyle}"
                                                           FontFamily="{StaticResource MonoFontFamily}" />
                                                <Grid ColumnSpacing="10" RowSpacing="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="大小"
                                                               Style="{StaticResource DetailLabelStyle}" />
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind DetailSizeText}"
                                                               Style="{StaticResource DetailValueStyle}" />
                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="修改时间"
                                                               Style="{StaticResource DetailLabelStyle}" />
                                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{x:Bind DetailTimeText}"
                                                               Style="{StaticResource DetailValueStyle}" />

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="位置"
                                                               Style="{StaticResource DetailLabelStyle}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind DetailLocationText}"
                                                               Style="{StaticResource DetailValueStyle}"
                                                               Grid.ColumnSpan="3" />

                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="重复组"
                                                               Style="{StaticResource DetailLabelStyle}" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind DetailGroupText}"
                                                               Style="{StaticResource DetailValueStyle}"
                                                               Grid.ColumnSpan="3" />

                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="处理"
                                                               Style="{StaticResource DetailLabelStyle}"
                                                               Visibility="{x:Bind FileRowVisibility, Mode=OneWay}" />
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind DetailRoleText}"
                                                               Style="{StaticResource DetailValueStyle}"
                                                               Grid.ColumnSpan="3" />
                                                </Grid>

                                                <!-- 组内对比：把所有副本的位置和时间排开，
                                                     一眼看出该留哪个，不用逐行点开 -->
                                                <Border Visibility="{x:Bind CompareVisibility, Mode=OneWay}"
                                                        Padding="8,6" CornerRadius="4"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="组内对比（▶ = 保留，◆ = 当前行）"
                                                                   Style="{StaticResource DetailLabelStyle}" />
                                                        <TextBlock Text="{x:Bind DetailCompareText}"
                                                                   Style="{StaticResource DetailValueStyle}"
                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                   IsTextSelectionEnabled="True" />
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock Text="双击这一行可把它设为该组的保留项"
                                                           Style="{StaticResource DetailLabelStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </ToolTipService.ToolTip>
                                    <!-- /CASE:tooltip -->

                                    <Grid Grid.Column="0">
                                        <CheckBox Visibility="{x:Bind GroupRowVisibility, Mode=OneWay}"
                                                  IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                                        <!--
                                          角色标记用形状而不是图标字形：Segoe MDL2 的
                                          私有区码位（E3BE/E43C）在 WinUI 3 默认图标字体
                                          里没有对应字形，会渲染成豆腐块。颜色 + 右侧
                                          的"保留/删除"文字已经说清角色，不值得为个图标
                                          去赌字体。
                                        -->
                                        <Ellipse Width="8" Height="8"
                                                 Fill="{x:Bind RoleBrush, Mode=OneWay}"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"
                                                 Visibility="{x:Bind FileRoleVisibility, Mode=OneWay}" />
                                    </Grid>

                                    <!-- 文件名 + 所在位置合成一列：判断该删哪个靠的是
                                         「哪个文件 + 放在哪」，拆到两个远隔的列里
                                         要来回对视线，不如并排放。 -->
                                    <StackPanel Grid.Column="1" Spacing="0"
                                                VerticalAlignment="Center"
                                                Margin="{x:Bind NameMargin, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind NameText}" FontSize="13"
                                                       FontWeight="{x:Bind NameWeight, Mode=OneWay}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <!-- 徽标用 Border 承载，不要给 TextBlock 设
                                                 Background/Padding/CornerRadius：WinUI 3 的
                                                 TextBlock 没有这三个属性（WPF 有），
                                                 写了 XamlCompiler 直接失败且只报「错误: 1」。 -->
                                            <Border Padding="6,1" CornerRadius="3"
                                                    Background="{StaticResource AccentBadgeBrush}"
                                                    VerticalAlignment="Center"
                                                    Visibility="{x:Bind CustomKeeperBadgeVisibility, Mode=OneWay}">
                                                <TextBlock Text="保留此项" FontSize="10" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4"
                                                    Visibility="{x:Bind FileRowVisibility, Mode=OneWay}">
                                            <TextBlock Text="在" FontSize="10" Opacity="0.45" />
                                            <TextBlock Text="{x:Bind PathText}" FontSize="11"
                                                       Style="{StaticResource MonoPathStyle}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" FontSize="12"
                                               Opacity="0.7" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind CountText}" FontSize="12"
                                               Opacity="0.7" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind WastedText}" FontSize="12"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <!-- 相对时间（"3 天前"）：一眼比出先后，
                                         绝对时间戳放在悬停详情里。 -->
                                    <TextBlock Grid.Column="5" Text="{x:Bind TimeLabel}" FontSize="12"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <!-- 组行显示时间跨度（最早 → 最晚），
                                         一眼看出这一组的副本"新不新" -->
                                    <TextBlock Grid.Column="5" Text="{x:Bind GroupTimeSpanText}"
                                               FontSize="11" Opacity="0.7"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind RoleText}" FontSize="11"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="7" Text="{x:Bind DriveLabel}"
                                               FontSize="11" Opacity="0.6"
                                               Style="{StaticResource MonoPathStyle}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Spacing="10" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE721;" FontSize="40" Opacity="0.25" />
                        <TextBlock Text="还没有结果" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Opacity="0.7" />
                        <TextBlock x:Name="EmptyStateDetail" Style="{StaticResource CaptionStyle}"
                                   HorizontalAlignment="Center" MaxWidth="440"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="3" Padding="0,10,0,10">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock x:Name="PhaseText" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock x:Name="SelectionText" Style="{StaticResource CaptionStyle}"
                                               FontSize="11" />
                                    <TextBlock x:Name="KeeperInfoText" Style="{StaticResource CaptionStyle}"
                                               FontSize="11" Opacity="0.85" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="SpeedText" Grid.Column="1" FontSize="12"
                                       Opacity="0.7" VerticalAlignment="Center" />
                        </Grid>
                        <Grid x:Name="ScanProgressPanel" Visibility="Collapsed" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="ScanProgress" Grid.Column="0"
                                         Minimum="0" Maximum="1" />
                            <TextBlock x:Name="ProgressPercent" Grid.Column="1" FontSize="12"
                                       VerticalAlignment="Center" Opacity="0.8" MinWidth="38"
                                       TextAlignment="Right" />
                        </Grid>

                        <!--
                          扫描进度详情：阶段步进器 + 实时统计。
                          只在扫描中显示。这里刻意不用 x:Bind 绑 ScanProgressModel
                          的属性——那是纯计算属性、没有变更通知，绑了也不会刷新；
                          统一由 OnUiTimerTick 显式推给各控件。
                        -->
                        <Border x:Name="ProgressDetailPanel" Visibility="Collapsed"
                                Style="{StaticResource CardStyle}" Padding="14">
                            <StackPanel Spacing="10">

                                <!--
                                  阶段步进器：固定写死 5 个，不用 ItemsControl。
                                  原因是 WinUI 3 的 ItemsControl 没有公开的容器生成器
                                  （ItemContainerGenerator / ContainerFromIndex 是 WPF 的 API），
                                  拿不到每个 item 的控件就没法按状态上色；而阶段数是固定的
                                  5 个，写死反而更简单可靠。状态由 OnUiTimerTick 推。
                                -->
                                <Grid x:Name="StageStrip">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                </Grid>

                                <!-- 总进度 -->
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <TextBlock x:Name="ProgressStageName" FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="ProgressStageDetail" FontSize="11"
                                                   Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock x:Name="ProgressOverallText" Grid.Column="1"
                                               FontSize="18" FontWeight="SemiBold"
                                               VerticalAlignment="Center" MinWidth="56"
                                               TextAlignment="Right" />
                                </Grid>
                                <ProgressBar x:Name="ProgressOverall" Minimum="0" Maximum="1"
                                             Height="6" />

                                <!-- 实时统计 -->
                                <Grid ColumnSpacing="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="1">
                                        <TextBlock Text="已扫描" FontSize="10" Opacity="0.55" />
                                        <TextBlock x:Name="StatFiles" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="已读数据" FontSize="10" Opacity="0.55" />
                                        <TextBlock x:Name="StatBytes" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="1">
                                        <TextBlock Text="已用时间" FontSize="10" Opacity="0.55" />
                                        <TextBlock x:Name="StatElapsed" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Spacing="1">
                                        <TextBlock Text="速度" FontSize="10" Opacity="0.55" />
                                        <TextBlock x:Name="StatSpeed" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Spacing="1">
                                        <TextBlock Text="目录" FontSize="10" Opacity="0.55" />
                                        <TextBlock x:Name="StatDirs" FontSize="12" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="ProgressNote" FontSize="10" Opacity="0.5"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!--
          状态条独占一行，不能浮在内容之上。之前放在 row 1 里
          VerticalAlignment=Bottom，会盖住左栏底部的「开始扫描」按钮和
          右栏的进度行——那些控件被盖住就点不到了。
        -->
        <InfoBar x:Name="StatusBar" Grid.Row="2"
                 HorizontalAlignment="Stretch" Margin="16,8,16,12"
                 IsOpen="False" IsClosable="True" />
    </Grid>
</Window>
